Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nonZero", "[", "exp_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Extract", "[", 
        RowBox[{"exp", ",", " ", "#"}], "]"}], " ", ",", " ", "#"}], "}"}], 
     "&"}], " ", "/@", 
    RowBox[{"Position", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "=!=", " ", "0"}], " ", "&"}], ",", " ", "exp", " ", 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"exp", "//", "TensorRank"}], "}"}]}], "]"}], " ", ",", " ", 
      "True"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonZero03", "[", "exp_", "]"}], ":=", 
   RowBox[{"Sort", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Extract", "[", 
          RowBox[{"exp", ",", " ", "#"}], "]"}], " ", ",", " ", 
         RowBox[{"#", "-", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "}"}], "&"}], " ", "/@", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "=!=", " ", "0"}], " ", "&"}], ",", " ", "exp", " ", 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"exp", "//", "TensorRank"}], "}"}]}], "]"}], " ", ",", " ",
         "True"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"#1", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", "<", 
      RowBox[{"#2", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9620339907946224`*^9, 3.962033991050649*^9}, {
