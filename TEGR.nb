      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}]], "Input",
