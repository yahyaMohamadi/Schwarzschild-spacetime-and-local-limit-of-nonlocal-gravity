          Blank[String]]] :> 
       Module[{OGRe`Private`RiemannID}, 
         OGRe`Private`CheckIfTensorExists[OGRe`Private`metricID]; 
         If[OGRe`Private`TensorData[OGRe`Private`metricID]["Role"] =!= 
           "Metric", Message[
             MessageName[OGRe`TCalcRiemannTensor, "ErrorNotMetric"]]; Abort[]; 
           Null]; If[
