Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "2"}], " ", 
          RowBox[{"gInv", "[", 
           RowBox[{"[", 
            RowBox[{"\[Lambda]", ",", "\[Sigma]"}], "]"}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"[", 
                RowBox[{"\[Sigma]", ",", "\[Mu]"}], "]"}], "]"}], ",", 
